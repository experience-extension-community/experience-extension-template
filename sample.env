# Do not commit this file's filled-in copy (`.env`) to source control —
# it will contain sensitive secrets. If you use a CI/CD system, use its
# own secret-management mechanism instead.
#
# Copy this file to `.env` and fill in the values you need.

# === REQUIRED ============================================================

# Upload token for deploying this extension to your Experience tenant.
# Generate one in the Experience admin UI → Extension Management.
EXPERIENCE_EXTENSION_UPLOAD_TOKEN=<upload-token>

# === OPTIONAL: Setup API ================================================
# Uncomment and fill these to use the Experience Setup API for tenant
# rollout. See the readme's "Utilizing the Setup API" section.
# EXPERIENCE_EXTENSION_SHARED_SECRET=<shared-secret>
# EXPERIENCE_EXTENSION_ENABLED=<true/false>
# EXPERIENCE_EXTENSION_ENVIRONMENTS=<Tenant1,Tenant2>

# === EXTENSION METADATA =================================================

# The publisher slug shown in Experience's Card Library. Default is the
# community slug; change to your institution's name when forking.
PUBLISHER=ExperienceExtensionCommunity

# === ETHOS / DATA CONNECT ===============================================

# Ethos API key for local dev only. In production this comes from the
# server-side card configuration set in the Experience admin UI; the
# value here is just a fallback for `npm start`.
ETHOS_API_KEY=

# Default Data Connect pipeline names — referenced by extension.js as
# the `default` for each card's pipeline configuration knob. Each name
# must match a pipeline that exists in your Ethos Data Connect tenant.
# The community ships starter pipelines under DataConnect/ that you can
# import unchanged; their names are pre-filled below.
PIPELINE_GET_STUDENTS=eec-template-persons-get
PIPELINE_GET_TERMS=eec-template-academic-periods-get

# === BRANDING ===========================================================

# Adobe Typekit kit ID for the institutional brand font.
# Default is the Florida Polytechnic University "New Science" kit.
# Replace with your kit, or leave blank to use system fallbacks.
TYPEKIT_KIT_ID=yld8vhe

# === DEBUG ==============================================================

# Loglevel for the bundled `loglevel` package. One of:
# trace, debug, info, warn, error, silent.
LOG_LEVEL=info

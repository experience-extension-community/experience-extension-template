# Local development environment for the Experience Extension Community template.
#
# 1. Copy this file to `.env.local` (which is gitignored).
# 2. Fill in the values that apply to your tenant.
# 3. NEVER commit `.env.local` or any file containing real credentials.
#
# In production, every value here is replaced by Experience-managed
# configuration (set in the Experience admin UI). These variables only
# affect local `npm start` runs.

# --- Ellucian Experience tenant -------------------------------------------
EXPERIENCE_TENANT_URL=https://experience.elluciancloud.com
EXPERIENCE_TENANT_ID=your-tenant-id-here

# --- Ethos Integration ----------------------------------------------------
# Use a non-production Ethos tenant for local development.
ETHOS_API_KEY=your-ethos-api-key-here
ETHOS_PROXY_URL=https://integrate.elluciancloud.com

# --- Data Connect (optional) ----------------------------------------------
# Set this to point local dev at a serverless API pipeline.
DATA_CONNECT_PIPELINE_URL=

# --- Branding (optional overrides) ----------------------------------------
# Override the institutional logo URL without editing tokens.js.
EXTENSION_LOGO_URL=

# --- Adobe Typekit (optional) ---------------------------------------------
# Typekit kit ID used by the brand font loader. Default value matches the
# Florida Polytechnic University "New Science" kit shipped with the template.
# Replace with your institution's kit, or leave blank to use system fallbacks.
TYPEKIT_KIT_ID=yld8vhe

# --- Feature flags --------------------------------------------------------
ENABLE_DEBUG_LOGGING=false

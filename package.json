{
  "name": "experience-extension-template",
  "version": "0.27.0",
  "private": true,
  "description": "Community template for Ellucian Experience extensions. Fork it, customize the branding tokens and configuration, and you have a publishable extension scaffolded against Experience SDK 8.1.2.",
  "license": "Apache-2.0",
  "author": "Experience Extension Community contributors",
  "main": "extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/experience-extension-community/experience-extension-template.git"
  },
  "homepage": "https://github.com/experience-extension-community/experience-extension-template#readme",
  "bugs": {
    "url": "https://github.com/experience-extension-community/experience-extension-template/issues"
  },
  "keywords": [
    "ellucian-experience",
    "experience-extension",
    "experience-template",
    "higher-education"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "lint": "eslint --ext .jsx,.js src",
    "lint:fix": "eslint --ext .jsx,.js src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build-dev": "webpack --progress --mode development --env verbose",
    "build-prod": "webpack --progress --mode production --env verbose",
    "deploy-dev": "webpack --progress --mode development --env verbose --env upload",
    "deploy-prod": "webpack --progress --mode production --env verbose --env upload",
    "watch-and-upload": "webpack --hot --watch --mode development --env verbose --env upload --env forceUpload",
    "start": "webpack serve --mode development --env verbose --env liveReload",
    "test": "cross-env BABEL_ENV=test jest",
    "test:ci": "cross-env BABEL_ENV=test jest --ci --coverage --runInBand",
    "test:watch": "cross-env BABEL_ENV=test jest --watch",
    "verify": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@ellucian/ds-icons": "https://cdn.elluciancloud.com/assets/EDS2/8.4.0/umd/path_design_system_icons.tgz",
    "@ellucian/experience-extension-utils": "https://cdn.elluciancloud.com/assets/SDK/utils/1.1.0/ellucian-experience-extension-utils-1.1.0.tgz",
    "@ellucian/react-design-system": "https://cdn.elluciancloud.com/assets/EDS2/8.4.0/umd/path_design_system.tgz",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "classnames": "2.2.6",
    "date-fns": "2.29.3",
    "loglevel": "1.9.1",
    "prop-types": "15.7.2",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "react-intl": "7.1.11",
    "react-router-dom": "5.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.27.4",
    "@babel/eslint-parser": "7.27.5",
    "@babel/plugin-transform-runtime": "7.27.3",
    "@babel/preset-env": "7.27.2",
    "@babel/preset-react": "7.27.1",
    "@ellucian/experience-extension": "https://cdn.elluciancloud.com/assets/SDK/8.1.2/ellucian-experience-extension-8.1.2.tgz",
    "@eslint/js": "9.33.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "babel-jest": "29.7.0",
    "babel-plugin-rewire": "1.2.0",
    "cross-env": "7.0.3",
    "dotenv": "8.6.0",
    "dotenv-webpack": "8.1.0",
    "eslint": "9.33.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.9.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-axe": "9.0.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.3.3",
    "webpack": "5.76.0",
    "webpack-cli": "4.10.0",
    "webpack-dev-server": "4.7.4"
  },
  "overrides": {
    "@ellucian/react-design-system": {
      "@tanstack/react-virtual": "3.11.3"
    }
  }
}
